{# Un champ de formulaire : étiquette, saisie, aide et erreurs. Usage : include '_field.html.twig' with {field: form.nom} #}
<div class="field{% if field.vars.errors|length %} has-error{% endif %}">
    {% if 'checkbox' in field.vars.block_prefixes %}
        <div class="check">{{ form_widget(field) }}{{ form_label(field) }}</div>
    {% else %}
        {{ form_label(field) }}
        {{ form_widget(field) }}
    {% endif %}
    {{ form_help(field) }}
    {{ form_errors(field) }}
</div>
