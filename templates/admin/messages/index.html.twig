{% extends 'admin/base.html.twig' %}
{% block title %}Messages{% endblock %}
{% block body %}
<h1>Messages reçus</h1>
{% if messages is empty %}
    <p class="muted">Aucun message pour l’instant.</p>
{% else %}
<div class="tablewrap">
<table>
    <thead><tr><th>Date</th><th>De</th><th>Aperçu</th><th></th></tr></thead>
    <tbody>
    {% for m in messages %}
        <tr class="{{ m.read ? '' : 'unread' }}">
            <td class="nowrap">{{ m.createdAt|date('d/m/Y H:i') }}</td>
            <td>{{ m.name }}<br><span class="muted small">{{ m.email }}</span></td>
            <td>{{ m.message|slice(0, 90) }}{{ m.message|length > 90 ? '…' : '' }}</td>
            <td class="nowrap"><a class="btn small ghost" href="{{ path('admin_message_show', {id: m.id}) }}">Lire</a></td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endif %}
{% endblock %}
