{% extends 'base.html.twig' %}

{% block title %}{% if status_code == 404 %}Page introuvable{% else %}Erreur{% endif %} | {{ site().siteName }}{% endblock %}

{% block body %}
<section class="narrow">
    <p class="eyebrow">Erreur {{ status_code }}</p>
    <h1>{% if status_code == 404 %}Page introuvable{% elseif status_code == 403 %}Accès refusé{% else %}Une erreur est survenue{% endif %}</h1>
    <p class="lead">{% if status_code == 404 %}Cette page n’existe pas ou n’existe plus.{% else %}Réessayez dans un instant.{% endif %}</p>
    <p><a class="btn" href="{{ path('home') }}">Retour à l’accueil</a></p>
</section>
{% endblock %}
